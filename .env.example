# Access token for the UI. Leave unset and the server generates one on first
# boot and writes it here; the unlock URL is printed to stdout.
RUFLOW_TOKEN=

# Port to listen on (default 3001)
PORT=3001

# Set to 1 to disable auth entirely. Only safe bound to localhost.
RUFLOW_OPEN=

# Set to "off" to drop --forward-subagent-text from the CLI spawn.
RUFLOW_SUBAGENT_TEXT=

# Set to "off" to ignore live subagent stream deltas.
SUBAGENT_DELTAS=
